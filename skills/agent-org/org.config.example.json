{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "_comment": "Project-specific path ownership for the agent-org. Edit globs to match YOUR repo. The roster is fixed; only the paths each department owns change per project. The CTO branch (5 depts) and the write-capable CAO + CMO depts (copy, coding-cao, demand, content) have Edit/Write tools and ARE enforced by path_guard. All other branches (CFO + COO + EA-rep + CPA-attest + the advisory CAO + CMO depts) are advisory (no Edit/Write) so their `scope` is informational only — path_guard never enforces against them.",
  "departments": {
    "backend": {
      "head": "cindy",
      "juniors": ["marcus", "priya"],
      "owns": [
        "src/server/**",
        "src/services/**",
        "src/lib/**",
        "internal/**"
      ]
    },
    "frontend": {
      "head": "gavin",
      "juniors": ["ava", "kai"],
      "owns": [
        "src/client/**",
        "src/pages/**",
        "src/components/**",
        "public/**",
        "*.css",
        "*.scss"
      ]
    },
    "database": {
      "head": "diana",
      "juniors": ["leo", "nora"],
      "owns": [
        "migrations/**",
        "db/**",
        "**/schema.sql",
        "**/schema.prisma",
        "**/alembic/**"
      ]
    },
    "qa": {
      "head": "rachel",
      "juniors": ["owen", "maya"],
      "owns": [
        "tests/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/test_*.py",
        "e2e/**",
        "playwright/**",
        "cypress/**"
      ]
    },
    "api": {
      "head": "josh",
      "juniors": ["felix", "zara"],
      "owns": [
        "src/api/**",
        "src/routes/**",
        "openapi.yaml",
        "openapi.json",
        "**/schemas/**"
      ]
    },
    "copy": {
      "_branch": "cao",
      "head": "camille",
      "juniors": [],
      "owns": [
        "content/**",
        "copy/**",
        "apps/web/src/strings/**",
        "**/*.mdx"
      ]
    },
    "coding-cao": {
      "_branch": "cao",
      "head": "cole",
      "juniors": [],
      "owns": [
        ".claude/cao-eval/**",
        ".claude/agents/cao-*.md",
        ".claude/agents/vp-ai-*.md",
        ".claude/agents/head-claude-*.md",
        ".claude/agents/head-copy-*.md",
        ".claude/agents/head-coding-*.md",
        ".claude/agents/wellness-officer-*.md"
      ]
    },
    "demand": {
      "_branch": "cmo",
      "head": "rocco",
      "juniors": ["tate"],
      "owns": [
        "marketing/campaigns/**",
        "marketing/paid/**",
        "marketing/lifecycle/**",
        "apps/web/src/landing/**"
      ]
    },
    "content": {
      "_branch": "cmo",
      "head": "yara",
      "juniors": ["luca"],
      "owns": [
        "marketing/content/**",
        "marketing/blog/**",
        "marketing/seo/**",
        "apps/web/blog/**",
        "apps/web/src/seo/**"
      ]
    }
  },
  "advisory_departments": {
    "_comment": "CFO + COO + EA-rep + CPA-attest branches plus the advisory CAO + CMO heads are advisory only. They have Read/Grep/Glob/Bash (+ Agent for heads) but NO Edit/Write tools. Path ownership is therefore not enforced. Subject-matter scope is documented here so cross-branch consults can route to the right head.",
    "cfo-controller": {
      "branch": "cfo",
      "head": "hal",
      "seniors": ["lila", "theo"],
      "scope": [
        "AP / AR / aging",
        "GL + monthly close",
        "Journal entries + accruals + reversals",
        "Revenue recognition (ASC 606)",
        "Workpaper structure + audit readiness",
        "Subledger-to-GL reconciliation"
      ]
    },
    "cfo-treasury": {
      "branch": "cfo",
      "head": "imani",
      "seniors": ["tomas", "bea"],
      "scope": [
        "Cash position (daily)",
        "13-week cash forecast",
        "Bank reconciliation",
        "Payment-processor settlement reconciliation",
        "Bill-pay queue + DPO levers",
        "Working capital + customer-deposit policy"
      ]
    },
    "cfo-tax": {
      "branch": "cfo",
      "head": "anya",
      "seniors": ["reyna", "devon"],
      "scope": [
        "Federal returns (1040 / 1120 / 1120-S / 1065 / 1041)",
        "State returns + multi-state apportionment + e-file matrix",
        "IRC 7216 consent governance + audit-log integrity",
        "IRC 6107(b) preparer responsibilities + retention",
        "Pub 4557 WISP §III tax-return-information controls",
        "ASC 740 income-tax provision (with controller)",
        "IRS / state-DOR notice + exam response (with EA-rep branch for representation engagements)"
      ]
    },
    "cfo-fpa": {
      "branch": "cfo",
      "head": "nadia",
      "seniors": ["eli", "quinn"],
      "scope": [
        "Annual operating plan (AOP) build + tracking",
        "Budget vs actual variance commentary",
        "Rolling 12-month forecast + sensitivities",
        "Scenario modeling (base / upside / downside)",
        "KPI definition discipline",
        "Customer-economics + cohort analysis"
      ]
    },
    "coo-hr": {
      "branch": "coo",
      "head": "roz",
      "seniors": ["lena", "chidi"],
      "scope": [
        "Hiring pipeline + offers (within plan)",
        "Onboarding (with §7216 + WISP training BEFORE first client-data touch)",
        "Comp within band + performance management + succession",
        "Engagement / retention",
        "CPE compliance + rollforward",
        "§7216 training records + WISP §III attestation"
      ]
    },
    "cao-claude": {
      "branch": "cao",
      "head": "clay",
      "seniors": [],
      "scope": [
        "Model selection per agent",
        "Prompt structure + frontmatter strategy",
        "Eval rubric + sample-set design",
        "Prompt-cache + thinking-budget strategy"
      ]
    },
    "cao-wellness": {
      "branch": "cao",
      "head": "wren",
      "seniors": [],
      "scope": [
        "Weekly wellness rollforward",
        "Stuck-junior pattern sweep",
        "Celebration-cadence tracking by EA",
        "Refusal-log digest"
      ]
    },
    "ea-rep-exams": {
      "branch": "ea-rep",
      "head": "otto",
      "seniors": ["tess"],
      "scope": [
        "Correspondence / office / field examinations",
        "IDR (Form 4564) response strategy",
        "Examination Appeals (jurisdiction / ex parte)",
        "Multi-state representation coordination",
        "Form 2848 / 8821 management + CAF discipline",
        "Pre-exam workpaper readiness (with cfo-tax)"
      ]
    },
    "ea-rep-collections": {
      "branch": "ea-rep",
      "head": "kira",
      "seniors": ["rafa"],
      "scope": [
        "Collection Due Process (CDP) under §§6320 / 6330",
        "Offer in Compromise (OIC) under §7122 + Forms 656 / 433-A(OIC) / 433-B(OIC)",
        "Installment Agreements under §6159",
        "Currently-Not-Collectible (CNC) status",
        "Federal tax liens (§§6321-6323) + lien discharge / subordination / withdrawal",
        "Levies (§6331) + levy release",
        "Trust Fund Recovery Penalty under §6672 + Form 4180 interview",
        "Form 433-A / 433-B financial reconciliation"
      ]
    },
    "ea-rep-notices": {
      "branch": "ea-rep",
      "head": "mateo",
      "seniors": ["ines"],
      "scope": [
        "CP2000 / CP2501 underreporter notices through Statutory Notice of Deficiency",
        "Innocent spouse relief under §6015 + Form 8857",
        "FOIA requests + IRS document inspection",
        "IRS e-Services (TDS / TIN matching / account / CAF maintenance)",
        "Letter 1058 / LT 11 / Letter 11 final notice timeline",
        "Form 8886 reportable transaction disclosure",
        "Circular 230 §10.20 prompt-records-submission posture"
      ]
    },
    "cpa-audit": {
      "branch": "cpa-attest",
      "head": "priscilla",
      "seniors": ["niall"],
      "scope": [
        "Financial-statement audits under AICPA AU-C clarified standards (SAS series)",
        "Risk assessment + planning + materiality",
        "Substantive testing + sampling + analytical procedures",
        "Going concern (ASC 205-40) + subsequent events (ASC 855)",
        "Workpaper / audit-file documentation (AS-1215-equivalent)",
        "Audit committee communications (KAMs / CAMs)",
        "PCAOB AS overlay for issuer audits (when applicable)"
      ]
    },
    "cpa-attest-other": {
      "branch": "cpa-attest",
      "head": "mason",
      "seniors": ["orla"],
      "scope": [
        "Non-audit attest under SSAE (examinations / reviews / agreed-upon procedures)",
        "SSARS reviews + compilations + preparation engagements",
        "SOC 1 / SOC 2 / SOC 3 / SOC for Cybersecurity / SOC for Supply Chain",
        "ASC 606 / 740 / 805 / 842 / 326 (CECL) attest-side perspective",
        "GASB + Yellow Book (GAGAS) governmental engagements",
        "Engagement acceptance + continuance (AU-C 220 / QM 1)"
      ]
    },
    "cpa-quality": {
      "branch": "cpa-attest",
      "head": "saira",
      "seniors": ["finn"],
      "scope": [
        "System of Quality Management (SQMS 1 / 2 / SAS 146)",
        "AICPA peer review program (System Review vs Engagement Review)",
        "AICPA Code of Professional Conduct + conceptual framework",
        "Licensure ladder (150-hour rule / ethics exam / experience)",
        "AICPA + NASBA + state society CPE rollforward",
        "Cross-branch independence wall vs CFO and EA-rep engagements",
        "Disciplinary mechanisms (AICPA JEEP / state board / PCAOB)"
      ]
    },
    "cmo-brand": {
      "branch": "cmo",
      "head": "sela",
      "seniors": ["fern"],
      "scope": [
        "Positioning (Ries/Trout, Aaker, Christensen JTBD)",
        "STP — segmentation / targeting / positioning",
        "Brand architecture (branded house / sub-brand / endorsed)",
        "Brand equity tracking (Aaker, Keller CBBE)",
        "Brand voice authoring methodology + voice rubric",
        "Brand-voice handshake to CAO Copy Dept (Camille)"
      ]
    },
    "cmo-analytics": {
      "branch": "cmo",
      "head": "arlo",
      "seniors": ["iggy"],
      "scope": [
        "Attribution models + incrementality testing",
        "Martech stack architecture (Brinker 5-system framework)",
        "Marketing budgeting + CMO/CFO seam (percent-of-revenue rule)",
        "MarOps / RevOps boundary",
        "Customer research (qual / quant / digital ethnography)",
        "Brand metrics + NPS critique",
        "Competitive intelligence + win/loss"
      ]
    }
  },
  "shared": [
    "README.md",
    "CLAUDE.md",
    ".claude/**",
    "docs/**",
    "research/**",
    "backlog/**",
    "package.json",
    "pyproject.toml",
    "requirements*.txt",
    ".gitignore"
  ]
}
